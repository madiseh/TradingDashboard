<Project>
  <PropertyGroup>
    <TradingDashboardTargetFramework>net10.0</TradingDashboardTargetFramework>
    <TradingDashboardMauiTargetFrameworks>$(TradingDashboardTargetFramework)-android;$(TradingDashboardTargetFramework)-ios</TradingDashboardMauiTargetFrameworks>
    <TradingDashboardMauiWindowsTargetFramework>$(TradingDashboardTargetFramework)-windows10.0.19041.0</TradingDashboardMauiWindowsTargetFramework>
    <RestoreBuildInParallel>false</RestoreBuildInParallel>
  </PropertyGroup>
</Project>
