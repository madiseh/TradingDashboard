{
  "CurrencyStrengthCollector": {
    "BaseUrl": "https://fx-chart.net/base_api/strength_base.php",
    "StorageRoot": "storage\\currency-strength",
    "RequestTimeoutSeconds": 30,
    "RunOnStartup": true,
    "IntervalMinutes": 1,
    "SnapshotRetentionDays": 14,
    "Timeframes": [
      { "Key": "today", "Label": "Today", "QueryValue": "today" },
      { "Key": "lastday", "Label": "Last Day", "QueryValue": "lastday" },
      { "Key": "10min", "Label": "10m", "QueryValue": "10min" },
      { "Key": "30min", "Label": "30m", "QueryValue": "30min" },
      { "Key": "1hour", "Label": "1H", "QueryValue": "1hour" },
      { "Key": "4hour", "Label": "4H", "QueryValue": "4hour" },
      { "Key": "8hour", "Label": "8H", "QueryValue": "8hour" },
      { "Key": "12hour", "Label": "12H", "QueryValue": "12hour" },
      { "Key": "24hour", "Label": "24H", "QueryValue": "24hour" },
      { "Key": "48hour", "Label": "48H", "QueryValue": "48hour" },
      { "Key": "72hour", "Label": "72H", "QueryValue": "72hour" },
      { "Key": "1week", "Label": "1W", "QueryValue": "1week" },
      { "Key": "1mon", "Label": "1Mon", "QueryValue": "1mon" },
      { "Key": "lastmon", "Label": "Last Mon", "QueryValue": "lastmon" },
      { "Key": "3mon", "Label": "3Mon", "QueryValue": "3mon" },
      { "Key": "1y", "Label": "1Y", "QueryValue": "1y" },
      { "Key": "3y", "Label": "3Y", "QueryValue": "3y" },
      { "Key": "5y", "Label": "5Y", "QueryValue": "5y" },
      { "Key": "10y", "Label": "10Y", "QueryValue": "10y" }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
