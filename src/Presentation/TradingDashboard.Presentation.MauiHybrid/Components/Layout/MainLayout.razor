@inherits LayoutComponentBase
@using TradingDashboard.Presentation.Common.Resources.Components.Layout.MauiHybridMainLayout
@inject IStringLocalizer<MauiHybridMainLayoutResource> L

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Dense="true">
        <MudText Typo="Typo.h6">@L["AppName"]</MudText>
        <MudSpacer />
        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small">
            @CurrentPlatformLabel
        </MudChip>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="td-maui-shell">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
