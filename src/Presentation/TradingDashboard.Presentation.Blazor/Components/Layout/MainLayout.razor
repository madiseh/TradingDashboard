@code {
    private string _selectedCulture = "en";

    private static readonly IReadOnlyList<(string Code, string Label, string ShortLabel)> SupportedLanguages =
    [
        ("en", "English", "En"),
        ("fa", "Persian", "Fa"),
        ("tr", "Turkish", "Tr"),
        ("de", "Deutsch", "De")
    ];

    private static string Img(string relativePath) => $"/images/tradexy/{relativePath}";

    private static string GetMenuLabel(int index) => index switch
    {
        1 => "One",
        2 => "Two",
        3 => "Three",
        4 => "Four",
        5 => "Five",
        _ => index.ToString(CultureInfo.InvariantCulture)
    };

    protected override void OnInitialized()
    {
        _selectedCulture = NormalizeCulture(CultureInfo.CurrentUICulture.Name);
    }

    private async Task OnCultureChangedAsync(string culture)
    {
        var normalizedCulture = NormalizeCulture(culture);
        _selectedCulture = normalizedCulture;

        await JSRuntime.InvokeVoidAsync("tradingDashboardCulture.set", normalizedCulture);

        var currentUri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        NavigationManager.NavigateTo(currentUri.PathAndQuery, forceLoad: true);
    }

    private static string NormalizeCulture(string? culture) =>
        SupportedLanguages.Any(language => string.Equals(language.Code, culture, StringComparison.OrdinalIgnoreCase))
            ? culture!
            : culture?.Split('-', StringSplitOptions.RemoveEmptyEntries)[0].ToLowerInvariant() switch
            {
                "fa" => "fa",
                "tr" => "tr",
                "de" => "de",
                _ => "en"
            };
}
