@inherits LayoutComponentBase
@using TradingDashboard.Presentation.Common.Resources.Components.Layout.MainLayout
@inject IStringLocalizer<MainLayoutResource> L

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar Elevation="1" Color="Color.Primary">
        <MudText Typo="Typo.h6">@L["AppName"]</MudText>
        <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="@RoutePaths.Ui.Home" Class="ml-4">@L["Menu.Home"]</MudButton>
        <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="@RoutePaths.Ui.CotHome">@L["Menu.Cot"]</MudButton>
        <MudSpacer />
        <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Href="@RoutePaths.Ui.Login">@L["Menu.Login"]</MudButton>
    </MudAppBar>

    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="mt-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    @L["Common.UnhandledError"]
    <a href="." class="reload">@L["Common.Reload"]</a>
    <span class="dismiss">x</span>
</div>
