<!DOCTYPE html>
<html lang="@CultureInfo.CurrentUICulture.Name" dir="@(CultureInfo.CurrentUICulture.TextInfo.IsRightToLeft ? "rtl" : "ltr")">

<head>
    <script id="cookieyes" type="text/javascript" src="https://cdn-cookieyes.com/client_data/75a44bedb1c4246b0619bb80/script.js"></script>
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-PDMZG45GBL"></script>
    <script src="@Assets["js/google-analytics.js"]"></script>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="application-name" content="@SiteBranding.BrandName" />
    <meta name="apple-mobile-web-app-title" content="@SiteBranding.BrandName" />
    <meta name="google-site-verification" content="@SiteBranding.GoogleSiteVerificationToken" />
    <meta name="theme-color" content="#122C57" />
    <base href="/" />
    <link rel="icon" type="image/svg+xml" href="@SiteBranding.Image("logo/favicon.svg")" />
    <link rel="stylesheet" href="@SiteBranding.ThemeAsset("vendor/bootstrap/css/bootstrap.min.css")" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.5/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="@SiteBranding.ThemeAsset("css/style.css")" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["TradingDashboard.Presentation.Blazor.styles.css"]" />
    <ImportMap />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <AuthSessionPersistence @rendermode="InteractiveServer" />
    <Routes @rendermode="InteractiveServer" />
    <script>
        window.tradingDashboardAuth = {
            get: function () {
                const raw = window.localStorage.getItem("td.auth.session");
                return raw ? JSON.parse(raw) : null;
            },

            set: function (session) {
                if (!session) {
                    window.localStorage.removeItem("td.auth.session");
                    return;
                }

                window.localStorage.setItem("td.auth.session", JSON.stringify(session));
            },

            clear: function () {
                window.localStorage.removeItem("td.auth.session");
            }
        };

        window.tradingDashboardCulture = {
            set: function (culture) {
                document.cookie = ".AspNetCore.Culture=c=" + culture + "|uic=" + culture + "; path=/; max-age=31536000; samesite=lax";
            }
        };

        window.tradingDashboardViewport = {
            scrollElementIntoView: function (element) {
                if (!element) {
                    return;
                }

                const top = window.scrollY + element.getBoundingClientRect().top - 24;
                window.scrollTo({ top, behavior: "smooth" });
            },

            scrollElementIntoViewById: function (elementId) {
                if (!elementId) {
                    return;
                }

                const element = document.getElementById(elementId);
                if (!element) {
                    return;
                }

                requestAnimationFrame(function () {
                    const header = document.querySelector(".header-section");
                    const headerHeight = header ? header.getBoundingClientRect().height : 0;
                    const top = window.scrollY + element.getBoundingClientRect().top - headerHeight - 24;
                    window.scrollTo({ top, behavior: "smooth" });
                });
            }
        };

        window.tradingDashboardNavigation = {
            closeOffcanvas: function (offcanvasId) {
                if (!offcanvasId || typeof bootstrap === "undefined" || !bootstrap.Offcanvas) {
                    return;
                }

                const offcanvasElement = document.getElementById(offcanvasId);
                if (!offcanvasElement) {
                    return;
                }

                bootstrap.Offcanvas.getOrCreateInstance(offcanvasElement).hide();
            }
        };

    </script>
    <script src="@SiteBranding.ThemeAsset("vendor/bootstrap/js/bootstrap.bundle.min.js")"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>
