@page "/cot"
@inherits TradingDashboard.Presentation.Blazor.Components.Pages.PageComponentBase
@using TradingDashboard.Presentation.Common.Resources.Components.Pages.Cot.Home

<PageTitle>@L["PageTitle"]</PageTitle>
<HeadContent>
    <meta name="description" content="@L["Seo.Description"]" />
    <meta name="keywords" content="@L["Seo.Keywords"]" />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href="@SiteBranding.AbsoluteUrl(RoutePaths.Ui.CotHome)" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@SiteBranding.BrandName" />
    <meta property="og:title" content="@L["Seo.Title"]" />
    <meta property="og:description" content="@L["Seo.Description"]" />
    <meta property="og:url" content="@SiteBranding.AbsoluteUrl(RoutePaths.Ui.CotHome)" />
    <meta property="og:image" content="@SiteBranding.AbsoluteUrl(SiteBranding.Image("hero/hero-thumb1.png"))" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@L["Seo.Title"]" />
    <meta name="twitter:description" content="@L["Seo.Description"]" />
    <meta name="twitter:image" content="@SiteBranding.AbsoluteUrl(SiteBranding.Image("hero/hero-thumb1.png"))" />
</HeadContent>

<section class="td-inner-hero td-inner-hero--light">
    <div class="container">
        <div class="section__content text-center">
            <span class="section__content-sub-title headingFour"><img src="@SiteBranding.Image("element/section-badge1.png")" alt="Badge" />@L["Hero.Badge"]</span>
            <h1 class="section__content-title">@L["Heading.MarketsDirectory"]</h1>
            <p class="section__content-text">@L["Hero.Description"]</p>
        </div>
    </div>
</section>

<section class="section td-cot-section">
    <div class="container">
        <div class="td-cot-panel">
            <MudStack Spacing="3">
                @if (_isLoading)
                {
                    <MudPaper Class="pa-6 d-flex justify-center">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    </MudPaper>
                }
                else if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">
                        @_errorMessage
                        <MudButton Class="ml-2" Variant="Variant.Outlined" Size="Size.Small" OnClick="LoadDirectoryAsync">@L["Actions.Retry"]</MudButton>
                    </MudAlert>
                }
                else
                {
                    <MudGrid>
                        @foreach (var group in _groups)
                        {
                            <MudItem xs="12" md="6">
                                <MudPaper Class="pa-3" Elevation="1">
                                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                        <MudText Typo="Typo.h5">@group.Type</MudText>
                                        <MudStack Row="true" Spacing="2">
                                            <MudLink Href="@BuildMarketsLink(group.Type, CotReportModel.CotLegacy)">@L["Links.MoreInCotLegacy"]</MudLink>
                                            <MudLink Href="@BuildMarketsLink(group.Type, CotReportModel.Cot)">@L["Links.MoreInCot"]</MudLink>
                                        </MudStack>
                                    </MudStack>

                                    <MudSimpleTable Dense="true" Class="mt-2">
                                        <thead>
                                            <tr>
                                                <th>@L["Table.Instrument"]</th>
                                                <th class="text-center">COT Legacy</th>
                                                <th class="text-center">COT</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var item in group.Items)
                                            {
                                                <tr>
                                                    <td>@item.Name</td>
                                                    <td class="text-center">
                                                        @if (HasModel(item, CotReportModel.CotLegacy))
                                                        {
                                                            <MudLink Href="@BuildCotLink(item.Slug, CotReportModel.CotLegacy)">COT Legacy</MudLink>
                                                        }
                                                    </td>
                                                    <td class="text-center">
                                                        @if (HasModel(item, CotReportModel.Cot))
                                                        {
                                                            <MudLink Href="@BuildCotLink(item.Slug, CotReportModel.Cot)">COT</MudLink>
                                                        }
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </MudSimpleTable>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>
                }
            </MudStack>
        </div>
    </div>
</section>
