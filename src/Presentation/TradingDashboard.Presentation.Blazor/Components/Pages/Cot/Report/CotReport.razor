@page "/cot/report/{InstrumentSlug}"
@inherits TradingDashboard.Presentation.Blazor.Components.Pages.PageComponentBase

<PageTitle>COT Report</PageTitle>

<section class="td-inner-hero td-inner-hero--light">
    <div class="container">
        <div class="section__content text-center">
            <span class="section__content-sub-title headingFour"><img src="/images/tradexy/element/section-badge1.png" alt="Badge" /> Detailed Report</span>
            <h1 class="section__content-title">COT Report: @GetDisplayName(InstrumentSlug)</h1>
            <p class="section__content-text">Review the selected market's latest snapshot, compare open interest changes, and explore long-short positioning in the same public-facing layout.</p>
        </div>
    </div>
</section>

<section class="section td-cot-section">
    <div class="container">
        <div class="td-cot-panel">
            <MudStack Spacing="3">
                <CotBreadcrumb CurrentPageTitle="@GetBreadcrumbTitle()" />

                @if (_isLoading)
                {
                    <MudPaper Class="pa-6 d-flex justify-center">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    </MudPaper>
                }
                else if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">
                        @_errorMessage
                    </MudAlert>
                }
                else if (_report is null)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        No collected report was found for this market yet.
                    </MudAlert>
                }
                else
                {
                    <MudPaper Class="pa-6">
                        <MudStack AlignItems="AlignItems.Center" Spacing="2">
                            <MudText Typo="Typo.h3" Align="Align.Center">
                                COT Report: @GetDisplayName(InstrumentSlug)
                            </MudText>

                            <MudGrid Class="w-100 mt-2">
                                <MudItem xs="12" md="8">
                                    <MudPaper Outlined="true" Class="pa-4 h-100">
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.h5">@GetMarketAndExchangeLabel()</MudText>

                                            @if (!string.IsNullOrWhiteSpace(GetContractUnitsLabel()))
                                            {
                                                <MudText Typo="Typo.subtitle1" Color="Color.Secondary">
                                                    @GetContractUnitsLabel()
                                                </MudText>
                                            }

                                            <MudText Typo="Typo.body1">
                                                CFTC Code: <strong>@GetInstrumentCodeLabel()</strong>
                                            </MudText>

                                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.Center">
                                                <MudText Typo="Typo.body1">
                                                    Open Interest: <strong>@FormatNumber(_report.OpenInterestAll)</strong>
                                                </MudText>
                                                <MudText Typo="Typo.body1">
                                                    Total Changes:
                                                    <MudChip T="string"
                                                             Size="Size.Small"
                                                             Variant="Variant.Filled"
                                                             Color="@GetChangeColor(_report.ChangeInOpenInterestAll)"
                                                             Class="ml-1">
                                                        @FormatSignedNumber(_report.ChangeInOpenInterestAll)
                                                    </MudChip>
                                                </MudText>
                                                <MudText Typo="Typo.body1">
                                                    Total Traders: <strong>@FormatNumber(_report.TotalTraders)</strong>
                                                </MudText>
                                            </MudStack>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12" md="4">
                                    <MudPaper Outlined="true" Class="pa-4 h-100">
                                        <MudStack Spacing="2" AlignItems="AlignItems.Start">
                                            <MudText Typo="Typo.h5">AS OF: @GetAsOfDateLabel()</MudText>
                                            <MudDatePicker Date="SelectedAsOfDate"
                                                           DateChanged="OnSelectedAsOfDateChangedAsync"
                                                           Label="As Of Date"
                                                           Variant="Variant.Outlined"
                                                           IsDateDisabledFunc="IsNotTuesday" />
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>

                            <MudText Typo="Typo.body1" Align="Align.Left" Class="mt-4">
                                Below is the Commitments of Traders (COT) report for @GetDisplayName(InstrumentSlug)
                                (@GetModelDescription()) loaded from the selected collected JSON snapshot.
                            </MudText>
                        </MudStack>
                    </MudPaper>

                    <CotReportTable Model="@ReportModel" Report="@_report" />
                    <CotLongShortChart Model="@ReportModel" Report="@_report" />
                    <CotPositionChart InstrumentSlug="@InstrumentSlug" Model="@ReportModel" />
                }
            </MudStack>
        </div>
    </div>
</section>
