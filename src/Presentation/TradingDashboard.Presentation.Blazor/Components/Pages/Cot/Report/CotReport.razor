@page "/cot/report/{InstrumentSlug}"
@inherits TradingDashboard.Presentation.Blazor.Components.Pages.PageComponentBase

<PageTitle>@GetPageTitle()</PageTitle>
<HeadContent>
    <meta name="description" content="@GetSeoDescription()" />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href="@BuildCanonicalUrl()" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@SiteBranding.BrandName" />
    <meta property="og:title" content="@GetPageTitle()" />
    <meta property="og:description" content="@GetSeoDescription()" />
    <meta property="og:url" content="@BuildCanonicalUrl()" />
    <meta property="og:image" content="@SiteBranding.AbsoluteUrl(SiteBranding.Image("hero/hero-thumb1.png"))" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@GetPageTitle()" />
    <meta name="twitter:description" content="@GetSeoDescription()" />
    <meta name="twitter:image" content="@SiteBranding.AbsoluteUrl(SiteBranding.Image("hero/hero-thumb1.png"))" />
</HeadContent>

<section class="td-inner-hero td-inner-hero--light">
    <div class="container">
        <div class="section__content text-center">
            <CotBreadcrumb CurrentPageTitle="@GetBreadcrumbTitle()" />
            <span class="section__content-sub-title headingFour"><img src="@SiteBranding.Image("element/section-badge1.png")" alt="Badge" /> Detailed Report</span>
            <h1 class="section__content-title td-cot-hero-title">
                <span class="td-cot-model-switch" role="group" aria-label="Report type">
                    <button type="button"
                            class="@GetModelSwitchButtonClass(CotReportModel.Cot)"
                            @onclick="@(() => SwitchReportModel(CotReportModel.Cot))">
                        COT Report
                    </button>
                    <button type="button"
                            class="@GetModelSwitchButtonClass(CotReportModel.CotLegacy)"
                            @onclick="@(() => SwitchReportModel(CotReportModel.CotLegacy))">
                        Legacy
                    </button>
                </span>
                <span class="td-cot-hero-instrument">@GetDisplayName(InstrumentSlug)</span>
            </h1>
            <p class="section__content-text">Review the selected market's latest snapshot, compare open interest changes, and explore long-short positioning in the same public-facing layout.</p>
        </div>
    </div>
</section>

<section class="section td-cot-section">
    <div class="container">
        <div class="td-cot-panel">
            <MudStack Spacing="3">
                @{
                    var report = _report;
                }

                @if (_isLoading)
                {
                    <MudPaper Class="pa-6 d-flex justify-center">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    </MudPaper>
                }
                else if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">
                        @_errorMessage
                    </MudAlert>
                }
                else if (report is null)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        No collected report was found for this market yet.
                    </MudAlert>
                }
                else
                {
                    <MudPaper Class="pa-6">
                        <MudStack AlignItems="AlignItems.Center" Spacing="2">
                            <MudGrid Class="w-100 mt-2">
                                <MudItem xs="12" md="8">
                                    <MudPaper Outlined="true" Class="pa-4 h-100">
                                        <MudStack Spacing="1">
                                            <MudText Typo="Typo.h5">@GetMarketAndExchangeLabel()</MudText>

                                            @if (!string.IsNullOrWhiteSpace(GetContractUnitsLabel()))
                                            {
                                                <MudText Typo="Typo.subtitle1" Color="Color.Secondary">
                                                    @GetContractUnitsLabel()
                                                </MudText>
                                            }

                                            <MudText Typo="Typo.body1">
                                                CFTC Code: <strong>@GetInstrumentCodeLabel()</strong>
                                            </MudText>

                                            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="2" AlignItems="AlignItems.Center">
                                                <MudText Typo="Typo.body1">
                                                    Open Interest: <strong>@FormatNumber(report.OpenInterestAll)</strong>
                                                </MudText>
                                                <MudText Typo="Typo.body1">
                                                    Total Changes:
                                                    <MudChip T="string"
                                                             Size="Size.Small"
                                                             Variant="Variant.Filled"
                                                             Color="@GetChangeColor(report.ChangeInOpenInterestAll)"
                                                             Class="ml-1">
                                                        @FormatSignedNumber(report.ChangeInOpenInterestAll)
                                                    </MudChip>
                                                </MudText>
                                                <MudText Typo="Typo.body1">
                                                    Total Traders: <strong>@FormatNumber(report.TotalTraders)</strong>
                                                </MudText>
                                            </MudStack>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>

                                <MudItem xs="12" md="4">
                                    <MudPaper Outlined="true" Class="pa-4 h-100">
                                        <MudStack Spacing="2" AlignItems="AlignItems.Start">
                                            <MudText Typo="Typo.h5">AS OF: @GetAsOfDateLabel()</MudText>
                                            <MudStack Row="true"
                                                      Spacing="1"
                                                      AlignItems="AlignItems.Center"
                                                      Class="w-100">
                                                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft"
                                                               Color="Color.Primary"
                                                               Disabled="@(!CanNavigateToPreviousDate)"
                                                               OnClick="NavigateToPreviousDateAsync"
                                                               aria-label="Go to previous available report date" />
                                                <MudDatePicker Date="SelectedAsOfDate"
                                                               DateChanged="OnSelectedAsOfDateChangedAsync"
                                                               Label="As Of Date"
                                                               Variant="Variant.Outlined"
                                                               Editable="false"
                                                               MinDate="MinAvailableDate"
                                                               MaxDate="MaxAvailableDate"
                                                               IsDateDisabledFunc="IsDateUnavailable"
                                                               Class="flex-grow-1" />
                                                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight"
                                                               Color="Color.Primary"
                                                               Disabled="@(!CanNavigateToNextDate)"
                                                               OnClick="NavigateToNextDateAsync"
                                                               aria-label="Go to next available report date" />
                                            </MudStack>
                                        </MudStack>
                                    </MudPaper>
                                </MudItem>
                            </MudGrid>

                            <MudText Typo="Typo.body1" Align="Align.Left" Class="mt-4">
                                Below is the Commitments of Traders (COT) report for @GetDisplayName(InstrumentSlug)
                                (@GetModelDescription()) loaded from the selected collected JSON snapshot.
                            </MudText>
                        </MudStack>

                        <CotReportTable Model="@ReportModel" Report="@report" />
                    </MudPaper>

                   
                    <CotLongShortChart Model="@ReportModel" Report="@report" />
                    <CotPositionChart InstrumentSlug="@InstrumentSlug" Model="@ReportModel" />
                }
            </MudStack>
        </div>
    </div>
</section>
