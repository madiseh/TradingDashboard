@page "/login"
@inherits PageComponentBase
@using TradingDashboard.Presentation.Common.Resources.Components.Pages.Workspace.Login

<PageTitle>@L["PageTitle"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-12">
    <MudGrid Spacing="4" Justify="Justify.Center">
        <MudItem xs="12" md="10" lg="8">
            <MudPaper Class="pa-6 mx-auto td-login-panel" Elevation="1">
                <MudText Typo="Typo.h4">@L["Heading.Title"]</MudText>
                <MudText Typo="Typo.body2" Class="mt-1 mb-4">@L["Heading.Description"]</MudText>

                <MudTabs Rounded="true" Elevation="0" @bind-ActivePanelIndex="_activeTabIndex">
                    <MudTabPanel Text="@L["Tabs.SignIn"]">
                        <MudForm @ref="_signInForm" Model="_signInModel">
                            <MudTextField T="string"
                                          @bind-Value="_signInModel.Identity"
                                          For="@(() => _signInModel.Identity)"
                                          Label="@L["Fields.Identity"]"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          RequiredError="@L["Validation.IdentityRequired"]"
                                          Immediate="true" />
                            <MudTextField T="string"
                                          @bind-Value="_signInModel.Password"
                                          For="@(() => _signInModel.Password)"
                                          Label="@L["Fields.Password"]"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          RequiredError="@L["Validation.PasswordRequired"]"
                                          InputType="InputType.Password"
                                          Immediate="true"
                                          Class="mt-2" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SignInAsync" Disabled="IsSignInDisabled" Class="mt-4">
                                @L["Actions.SignIn"]
                            </MudButton>

                            <div class="mt-2">
                                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="ForgotPasswordAsync" Disabled="IsIdentityActionDisabled">
                                    @L["Actions.ForgotPassword"]
                                </MudButton>

                                @if (_canSendActivationEmail)
                                {
                                    <MudButton Variant="Variant.Text" Color="Color.Secondary" OnClick="SendActivationEmailAsync" Disabled="IsIdentityActionDisabled" Class="ml-2">
                                        @L["Actions.SendActivationEmail"]
                                    </MudButton>
                                }
                            </div>
                        </MudForm>

                        @if (_canSendActivationEmail)
                        {
                            <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mt-4">
                                <strong>@L["States.EmailActivationRequired"]</strong>
                                <div>@L["States.EmailActivationRequiredDescription"]</div>
                            </MudAlert>
                        }
                    </MudTabPanel>

                    <MudTabPanel Text="@L["Tabs.SignUp"]">
                        <MudForm @ref="_signUpForm" Model="_signUpModel">
                            <MudTextField T="string"
                                          @bind-Value="_signUpModel.Username"
                                          For="@(() => _signUpModel.Username)"
                                          Label="@L["Fields.Username"]"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          RequiredError="@L["Validation.UsernameRequired"]"
                                          Immediate="true" />
                            <MudTextField T="string"
                                          @bind-Value="_signUpModel.Email"
                                          For="@(() => _signUpModel.Email)"
                                          Label="@L["Fields.Email"]"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          RequiredError="@L["Validation.EmailRequired"]"
                                          Immediate="true"
                                          Class="mt-2" />
                            <MudTextField T="string"
                                          @bind-Value="_signUpModel.Password"
                                          For="@(() => _signUpModel.Password)"
                                          Label="@L["Fields.Password"]"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          RequiredError="@L["Validation.PasswordRequired"]"
                                          InputType="InputType.Password"
                                          Immediate="true"
                                          Class="mt-2" />
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="SignUpAsync" Disabled="IsSignUpDisabled" Class="mt-4">
                                @L["Actions.SignUp"]
                            </MudButton>
                        </MudForm>
                    </MudTabPanel>
                </MudTabs>

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mt-4">
                        @_errorMessage
                    </MudAlert>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>
