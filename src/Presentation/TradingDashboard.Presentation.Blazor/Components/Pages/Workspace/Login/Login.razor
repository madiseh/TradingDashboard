@page "/login"
@inherits PageComponentBase

<PageTitle>Login</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="py-12">
    <MudGrid Spacing="4" Justify="Justify.Center">
        <MudItem xs="12" md="10" lg="8">
            <MudPaper Class="pa-6 mx-auto td-login-panel" Elevation="1">
                <MudText Typo="Typo.h4">Authentication</MudText>
                <MudText Typo="Typo.body2" Class="mt-1 mb-4">Sign in or create a new account to continue.</MudText>

                <MudTabs Rounded="true" Elevation="0" @bind-ActivePanelIndex="_activeTabIndex">
                    <MudTabPanel Text="Sign In">
                        <MudForm @ref="_signInForm" Model="_signInModel">
                            <MudTextField T="string"
                                          @bind-Value="_signInModel.Identity"
                                          For="@(() => _signInModel.Identity)"
                                          Label="Username or Email"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          RequiredError="Username or email is required."
                                          Immediate="true" />
                            <MudTextField T="string"
                                          @bind-Value="_signInModel.Password"
                                          For="@(() => _signInModel.Password)"
                                          Label="Password"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          RequiredError="Password is required."
                                          InputType="InputType.Password"
                                          Immediate="true"
                                          Class="mt-2" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SignInAsync" Disabled="IsSignInDisabled" Class="mt-4">
                                Sign In
                            </MudButton>
                        </MudForm>
                    </MudTabPanel>

                    <MudTabPanel Text="Sign Up">
                        <MudForm @ref="_signUpForm" Model="_signUpModel">
                            <MudTextField T="string"
                                          @bind-Value="_signUpModel.Username"
                                          For="@(() => _signUpModel.Username)"
                                          Label="Username"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          RequiredError="Username is required."
                                          Immediate="true" />
                            <MudTextField T="string"
                                          @bind-Value="_signUpModel.Email"
                                          For="@(() => _signUpModel.Email)"
                                          Label="Email"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          RequiredError="Email is required."
                                          Immediate="true"
                                          Class="mt-2" />
                            <MudTextField T="string"
                                          @bind-Value="_signUpModel.Password"
                                          For="@(() => _signUpModel.Password)"
                                          Label="Password"
                                          Variant="Variant.Outlined"
                                          Required="true"
                                          RequiredError="Password is required."
                                          InputType="InputType.Password"
                                          Immediate="true"
                                          Class="mt-2" />
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" OnClick="SignUpAsync" Disabled="IsSignUpDisabled" Class="mt-4">
                                Sign Up
                            </MudButton>
                        </MudForm>
                    </MudTabPanel>
                </MudTabs>

                @if (!string.IsNullOrWhiteSpace(_errorMessage))
                {
                    <MudAlert Severity="Severity.Error" Variant="Variant.Outlined" Dense="true" Class="mt-4">
                        @_errorMessage
                    </MudAlert>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
</MudContainer>
