@inherits LayoutComponentBase
@using TradingDashboard.Presentation.Common.Constants
@using TradingDashboard.Presentation.Common.Resources.Components.Layout.WorkspaceLayout
@using TradingDashboard.Presentation.Common.Routing
@inject IStringLocalizer<WorkspaceLayoutResource> L

<MudThemeProvider />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
<TopMenu />

    <MudMainContent style="padding-top:0px !important">
       @*  <MudContainer> *@
            <main class="td-site-main">
                @Body
            </main>
     @*    </MudContainer> *@
    </MudMainContent>


<footer class="footer footer-secondary cmn-bg1" id="footer">
    <div class="container">
        <div class="row section">
            <div class="col-12">
                <div class="footer-secondary__content">
                    <div class="footer__logo">
                        <a href="@RoutePaths.Ui.Home">
                            <img src="@SiteBranding.Image("logo/logo-light.svg")" alt="TerminalPrime footer logo" />
                        </a>
                    </div>
                    <div class="quick-link order-1 order-lg-0">
                        <ul class="quick-link__list">
                            <li><a href="@RoutePaths.Ui.Releases">@L["Footer.Releases"]</a></li>
                            <li><a href="/#footer">@L["Footer.HelpSupport"]</a></li>
                            <li><a href="/#footer">@L["Footer.PrivacyPolicy"]</a></li>
                            <li><a href="/#footer">@L["Footer.TermsConditions"]</a></li>
                            <li><a href="/#footer">@L["Footer.ContactUs"]</a></li>
                        </ul>
                    </div>
                    <div class="social">
                        <a href="#" class="btn_theme social_box"><i class="bi bi-facebook"></i><span></span></a>
                        <a href="#" class="btn_theme social_box"><i class="bi bi-twitter"></i><span></span></a>
                        <a href="#" class="btn_theme social_box"><i class="bi bi-pinterest"></i><span></span></a>
                        <a href="#" class="btn_theme social_box"><i class="bi bi-twitch"></i><span></span></a>
                        <a href="#" class="btn_theme social_box"><i class="bi bi-skype"></i><span></span></a>
                    </div>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="footer__copyright">
                    <p class="copyright text-center">
                        Copyright @@2026 <a href="@SiteBranding.BaseUrl" class="secondary_color">TerminalPrime.com</a>
                        <span class="d-block mt-1">@L["Footer.Version"] @ApplicationVersions.Blazor</span>
                    </p>
                </div>
            </div>
        </div>
    </div>
</footer>

<a href="#" class="scrollToTop"><i class="bi bi-chevron-double-up"></i></a>
</MudLayout>
<div id="blazor-error-ui" data-nosnippet>
    @L["Common.UnhandledError"]
    <a href="." class="reload">@L["Common.Reload"]</a>
    <span class="dismiss">x</span>
</div>
