@page "/currency-strength"
@inherits TradingDashboard.Presentation.Blazor.Components.Pages.PageComponentBase
@using TradingDashboard.Presentation.Common.Resources.Components.Pages.CurrencyStrength.Dashboard

<PageTitle>@L["PageTitle"]</PageTitle>
<HeadContent>
    <meta name="description" content="@L["Seo.Description"]" />
    <meta name="keywords" content="@L["Seo.Keywords"]" />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href="@BuildCanonicalUrl()" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@SiteBranding.BrandName" />
    <meta property="og:title" content="@L["Seo.Title"]" />
    <meta property="og:description" content="@L["Seo.Description"]" />
    <meta property="og:url" content="@BuildCanonicalUrl()" />
    <meta property="og:image" content="@SiteBranding.AbsoluteUrl(SiteBranding.Image("hero/hero-thumb1.png"))" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@L["Seo.Title"]" />
    <meta name="twitter:description" content="@L["Seo.Description"]" />
    <meta name="twitter:image" content="@SiteBranding.AbsoluteUrl(SiteBranding.Image("hero/hero-thumb1.png"))" />
</HeadContent>

<section class="td-inner-hero td-inner-hero--light currency-strength-dashboard-hero-section">
    <div class="container">
        <div class="section__content text-center currency-strength-dashboard-hero">
            <span class="section__content-sub-title headingFour"><img src="@SiteBranding.Image("element/section-badge1.png")" alt="Badge" />@L["Hero.Badge"]</span>
            <h1 class="section__content-title">@L["Hero.Title"]</h1>
            <p class="section__content-text currency-strength-dashboard-hero__text">@L["Hero.Description"]</p>
        </div>
    </div>
</section>

<section class="section td-cot-section">
    <div class="container-fluid currency-strength-dashboard-shell">
        <div class="td-cot-panel currency-strength-dashboard-panel">
            <MudStack Spacing="4" Class="currency-strength-dashboard">
                @if (_isLoadingTimeframes)
                {
                    <MudPaper Class="pa-6 d-flex justify-center">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    </MudPaper>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(_errorMessage))
                    {
                        <MudAlert Severity="Severity.Error" Dense="true">
                            @_errorMessage
                            <MudButton Class="ml-2" Variant="Variant.Outlined" Size="Size.Small" OnClick="ReloadAsync">@L["Actions.Retry"]</MudButton>
                        </MudAlert>
                    }
                    else if (_isLoadingSnapshot)
                    {
                        <MudPaper Class="pa-6 d-flex justify-center">
                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                        </MudPaper>
                    }
                    else if (_snapshot is not null)
                    {
                        <MudPaper Class="pa-4 currency-strength-dashboard__summary">
                            <MudStack Spacing="1">
                                <MudText Typo="Typo.h4" Class="currency-strength-dashboard__summary-title">@_snapshot.TimeframeLabel</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="currency-strength-dashboard__summary-copy">@_snapshot.Description</MudText>
                                <MudText Typo="Typo.body2" Class="currency-strength-dashboard__summary-copy">@L["Status.CollectedAt", _snapshot.CollectedAtUtc.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")]</MudText>
                                @if (_snapshot.LastPointAtUtc is not null)
                                {
                                    <MudText Typo="Typo.body2" Class="currency-strength-dashboard__summary-copy">@L["Status.LastPoint", _snapshot.LastPointAtUtc.Value.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")]</MudText>
                                }
                            </MudStack>
                        </MudPaper>

                        <div class="currency-strength-dashboard__utc-clock" aria-live="polite">
                            <span class="currency-strength-dashboard__utc-clock-label">Live UTC</span>
                            <span class="currency-strength-dashboard__utc-clock-value">@_currentUtcNow.ToString("yyyy-MM-dd HH:mm:ss 'UTC'")</span>
                        </div>

                        <div id="currency-strength-chart-anchor" class="currency-strength-dashboard__chart-anchor">
                            <CurrencyStrengthChart Snapshot="_snapshot" EmptyMessage="@L["Chart.Empty"]" />
                        </div>
                    }

                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="currency-strength-dashboard__timeframes">
                        @foreach (var timeframe in _timeframes)
                        {
                            <MudButton Variant="Variant.Filled"
                                       Color="@(timeframe.Key == _selectedTimeframeKey ? Color.Warning : Color.Primary)"
                                       Size="Size.Small"
                                       OnClick="@(() => OnTimeframeSelected(timeframe.Key))">
                                @timeframe.Label
                            </MudButton>
                        }
                    </MudStack>
                }
            </MudStack>
        </div>
    </div>
</section>
