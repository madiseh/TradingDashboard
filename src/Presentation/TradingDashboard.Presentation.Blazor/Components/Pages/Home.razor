@page "/"
@inject TradingDashboard.Presentation.Blazor.Features.Common.Services.ICommonDirectoryClient CommonDirectoryClient

<PageTitle>Home Directory</PageTitle>

<MudStack Spacing="3">
    <MudText Typo="Typo.h4">Markets Directory</MudText>

    @if (_isLoading)
    {
        <MudPaper Class="pa-6 d-flex justify-center">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
        </MudPaper>
    }
    else if (!string.IsNullOrWhiteSpace(_errorMessage))
    {
        <MudAlert Severity="Severity.Error" Dense="true">
            @_errorMessage
            <MudButton Class="ml-2" Variant="Variant.Outlined" Size="Size.Small" OnClick="LoadDirectoryAsync">Retry</MudButton>
        </MudAlert>
    }
    else
    {
        <MudGrid>
            @foreach (var group in _groups)
            {
                <MudItem xs="12" md="6">
                    <MudPaper Class="pa-3" Elevation="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText Typo="Typo.h5">@group.Type</MudText>
                            <MudStack Row="true" Spacing="2">
                                <MudLink Href="@BuildMarketsLink(group.Type, CotReportModel.CotLegacy)">More in COT Legacy »</MudLink>
                                <MudLink Href="@BuildMarketsLink(group.Type, CotReportModel.Cot)">More in COT »</MudLink>
                            </MudStack>
                        </MudStack>

                        <MudSimpleTable Dense="true" Class="mt-2">
                            <thead>
                                <tr>
                                    <th>Instrument</th>
                                    <th class="text-center">COT Legacy</th>
                                    <th class="text-center">COT</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in group.Items)
                                {
                                    <tr>
                                        <td>@item.Name</td>
                                        <td class="text-center">
                                            @if (HasModel(item, CotReportModel.CotLegacy))
                                            {
                                                <MudLink Href="@BuildCotLink(item.Slug, CotReportModel.CotLegacy)">COT Legacy</MudLink>
                                            }
                                        </td>
                                        <td class="text-center">
                                            @if (HasModel(item, CotReportModel.Cot))
                                            {
                                                <MudLink Href="@BuildCotLink(item.Slug, CotReportModel.Cot)">COT</MudLink>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </MudSimpleTable>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    }
</MudStack>

@code {
    private bool _isLoading = true;
    private string? _errorMessage;
    private IReadOnlyList<TradingDashboard.Presentation.Blazor.Features.Common.Contracts.MarketGroupDto> _groups = [];

    protected override async Task OnInitializedAsync()
    {
        await LoadDirectoryAsync();
    }

    private async Task LoadDirectoryAsync()
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var response = await CommonDirectoryClient.GetMarketsDirectoryAsync();
            _groups = response?.Groups ?? [];
        }
        catch
        {
            _errorMessage = "Failed to load market directory from API.";
            _groups = [];
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static bool HasModel(TradingDashboard.Presentation.Blazor.Features.Common.Contracts.MarketItemDto item, CotReportModel model)
    {
        var expectedValue = model.ToContractValue();
        return item.AvailableModels.Any(x => string.Equals(x, expectedValue, StringComparison.OrdinalIgnoreCase));
    }

    private static string BuildCotLink(string slug, CotReportModel model)
    {
        return $"{RoutePaths.Ui.Cot}/{slug}?model={model.ToContractValue()}";
    }

    private static string BuildMarketsLink(string type, CotReportModel model)
    {
        return $"{RoutePaths.Ui.Markets}/{type}?model={model.ToContractValue()}";
    }
}
