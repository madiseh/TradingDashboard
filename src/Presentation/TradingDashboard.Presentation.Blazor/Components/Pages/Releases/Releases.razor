@page "/releases"
@inherits TradingDashboard.Presentation.Blazor.Components.Pages.PageComponentBase
@using TradingDashboard.Presentation.Common.Resources.Components.Pages.Releases.Releases

<PageTitle>@L["PageTitle"]</PageTitle>

<section class="td-inner-hero td-inner-hero--light">
    <div class="container">
        <div class="section__content text-center">
            <span class="section__content-sub-title headingFour">
                <img src="/images/tradexy/element/section-badge1.png" alt="Badge" />
                @L["Hero.Eyebrow"]
            </span>
            <h1 class="section__content-title">@L["Hero.Title"]</h1>
            <p class="section__content-text">@L["Hero.Description"]</p>
        </div>
    </div>
</section>

<section class="section td-cot-section td-releases-section">
    <div class="container">
        <div class="td-cot-panel">
            <MudStack Spacing="3">
                <MudPaper Class="pa-4 td-release-summary" Elevation="1">
                    <MudStack Spacing="1">
                        <MudText Typo="Typo.overline" Class="td-release-summary__eyebrow">@L["Summary.Title"]</MudText>
                        <MudText Typo="Typo.h4">@L["Summary.UpdatedThrough", LatestReleaseDateLabel]</MudText>
                        <MudText Typo="Typo.body1">@L["Summary.Description"]</MudText>
                    </MudStack>
                </MudPaper>

                <MudText Typo="Typo.h4" Class="td-release-list-title">@L["List.Title"]</MudText>

                <div class="td-release-accordion">
                    @foreach (var entry in ReleaseEntries)
                    {
                        <details class="td-release-accordion__item" open="@entry.IsCurrent">
                            <summary class="td-release-accordion__summary">
                                <div class="td-release-accordion__summary-copy">
                                    <span class="td-release-accordion__version">@entry.VersionLabel</span>
                                    <span class="td-release-accordion__date">@entry.DisplayDate</span>
                                </div>
                                <div class="td-release-accordion__summary-meta">
                                    @if (entry.IsCurrent)
                                    {
                                        <MudChip T="string" Color="Color.Success" Variant="Variant.Filled" Size="Size.Small">@L["Labels.Current"]</MudChip>
                                    }
                                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">@L["Labels.Bullets", entry.Highlights.Count]</MudChip>
                                </div>
                            </summary>

                            <div class="td-release-accordion__content">
                                <h3>@entry.Title</h3>
                                <p>@entry.Description</p>

                                <ul class="td-release-card__list">
                                    @foreach (var highlight in entry.Highlights)
                                    {
                                        <li>@highlight</li>
                                    }
                                </ul>
                            </div>
                        </details>
                    }
                </div>
            </MudStack>
        </div>
    </div>
</section>
