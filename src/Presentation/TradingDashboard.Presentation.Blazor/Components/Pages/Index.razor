@page "/"
@using TradingDashboard.Presentation.Common.Routing

<PageTitle>@HomeSeoTitle</PageTitle>
<HeadContent>
    <meta name="description" content="@HomeSeoDescription" />
    <meta name="keywords" content="@HomeSeoKeywords" />
    <meta name="robots" content="index,follow" />
    <link rel="canonical" href="@SiteBranding.BaseUrl/" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@SiteBranding.BrandName" />
    <meta property="og:title" content="@HomeSeoTitle" />
    <meta property="og:description" content="@HomeSeoDescription" />
    <meta property="og:url" content="@SiteBranding.BaseUrl/" />
    <meta property="og:image" content="@SiteBranding.AbsoluteUrl(SiteBranding.Image("hero/hero-thumb1.png"))" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="@HomeSeoTitle" />
    <meta name="twitter:description" content="@HomeSeoDescription" />
    <meta name="twitter:image" content="@SiteBranding.AbsoluteUrl(SiteBranding.Image("hero/hero-thumb1.png"))" />
</HeadContent>

<section class="hero" id="hero" style="background-image: url('@Img("element/common-bg.png")');">
    <div class="container">
        <div class="row align-items-center justify-content-lg-between justify-content-center">
            <div class="col-xxl-5 col-xl-6 col-lg-6">
                <div class="banner-content text-lg-start text-center">
                    <span class="mb-4 primary-clr d-flex align-items-center justify-content-lg-start justify-content-center gap-lg-3 gap-2 headingFour">
                        <img src="@Img("element/section-badge1.png")" alt="@T("Common.BadgeAlt")" /> @T("Hero.Badge")
                    </span>
                    <h1 class="mb-4">
                        @T("Hero.TitlePrefix") <span class="secondary-clr2">@T("Hero.TitleHighlight")</span>@T("Hero.TitleSuffix")
                    </h1>
                    <p>@T("Hero.Description")</p>
                    <div class="btn-group justify-content-center justify-content-lg-start mt_40">
                        <a href="@RoutePaths.Ui.CotHome" class="btn_theme btn_theme_active">@T("Hero.PrimaryCta")<i class="bi bi-arrow-up-right"></i><span></span></a>
                        <a href="@RoutePaths.Ui.CurrencyStrength" class="btn_theme">@T("Hero.SecondaryCta")<i class="bi bi-arrow-up-right"></i><span></span></a>
                    </div>
                </div>
            </div>
            <div class="col-xxl-7 col-xl-6 col-lg-6">
                <div class="hero__thumb">
                    <img src="@Img("hero/hero-thumb1.png")" alt="@T("Hero.IllustrationAlt")" />
                </div>
            </div>
        </div>
    </div>
</section>

<section class="feature-section section" id="packages">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-9 col-xxl-8">
                <div class="section__header">
                    <span class="section__header-sub-title headingFour"><img src="@Img("element/section-badge1.png")" alt="@T("Common.BadgeAlt")" /> @T("Features.Badge")</span>
                    <h2 class="section__header-title">@T("Features.Title")</h2>
                    <p class="section__header-content">@T("Features.Description")</p>
                </div>
            </div>
        </div>
        <div class="row g-4">
            @foreach (var package in Packages)
            {
                <div class="col-12 col-md-6 col-xl-4">
                    <div class="card card--custom text-start td-card-fill">
                        <div class="d-flex align-items-start justify-content-between w-100">
                            <div class="icon">
                                <img src="@Img(package.Icon)" alt="@GetIconAlt(package.Title)" />
                            </div>
                            <a href="/#packages" class="btn_theme social_box m-0"><i class="bi bi-arrow-up-right"></i><span></span></a>
                        </div>
                        <div class="card__content">
                            <h4 class="card__title"><a href="/#packages">@package.Title</a></h4>
                            <p class="fs-small">@package.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="broker-review-section overflow-hidden cmn-bg2 section" id="broker-reviews">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-8 col-xxl-7">
                <div class="section__header">
                    <span class="section__header-sub-title headingFour"><img src="@Img("element/section-badge1.png")" alt="@T("Common.BadgeAlt")" /> @T("Broker.Badge")</span>
                    <h2 class="section__header-title">@T("Broker.Title")</h2>
                    <p class="section__header-content">@T("Broker.Description")</p>
                </div>
            </div>
        </div>
        <div class="broker-review-wrap">
            @foreach (var broker in Brokers)
            {
                <div class="broker-review-inner white-bg">
                    <span class="badge">@broker.Number</span>
                    <div class="broker-review-item style1 d-flex align-items-center position-relative">
                        <div class="broker-thumb-area">
                            <div class="thumb rounded-circle">
                                <img src="@Img(broker.Image)" alt="@broker.Name" class="rounded-circle" />
                            </div>
                            <div class="cont">
                                <h3 class="mb-1 black-clr">@broker.Name</h3>
                                <p class="black-clr">@broker.Description</p>
                            </div>
                        </div>
                        <div class="broker-ratting-box d-inline-block border rounded-3 text-center py-4 px-3">
                            <div class="star_review mb-xxl-3 mb-2 justify-content-center">
                                @for (var i = 0; i < 4; i++)
                                {
                                    <i class="bi bi-star-fill secondary-clr2"></i>
                                }
                                <i class="bi bi-star-half secondary-clr2"></i>
                            </div>
                            <h5 class="pra-clr">@broker.Reviews</h5>
                            <p class="pra-clr customer-text">@T("Broker.CustomerReviews")</p>
                        </div>
                        <div class="breoker-button-area text-center">
                            <span class="terms d-block mb-2">&middot; @T("Broker.TermsApply")</span>
                            <div class="text-center mb-3">
                                <a href="/#broker-reviews" class="btn_theme d-flex btn_theme_active">@T("Broker.VisitSite")<i class="bi bi-arrow-up-right"></i><span></span></a>
                            </div>
                            <div class="detail-btn text-center">
                                <button type="button" class="primary-clr m-auto d-flex align-items-center justify-content-center view-btn bg-transparent fw-semibold gap-2" data-bs-toggle="collapse" data-bs-target="#@broker.CollapseId" aria-expanded="@broker.IsExpanded.ToString().ToLowerInvariant()" aria-controls="@broker.CollapseId">
                                    @T("Broker.ViewMore") <i class="bi bi-chevron-down primary-clr"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                    <div id="@broker.CollapseId" class="view-content-wrap mt-xxl-4 mt-xl-3 mt-2 text-start collapse @(broker.IsExpanded ? "show" : null)">
                        <div class="box">
                            <h5 class="mb-2">@T("Broker.ExecutionNotesTitle")</h5>
                            <p class="mb-md-3 mb-3 pra-clr">@T("Broker.ExecutionNotesDescription")</p>
                            <ul class="cartified-cheking d-flex flex-wrap align-items-center gap-xxl-4 gap-xl-3 gap-2">
                                @foreach (var point in BrokerHighlights)
                                {
                                    <li class="d-flex align-items-center gap-2 pra-clr"><i class="bi bi-check2-circle primary-clr"></i> @point</li>
                                }
                            </ul>
                        </div>
                    </div>
                </div>
            }
            <div class="text-center mt_40">
                <a href="/#broker-reviews" class="btn_theme btn_theme_active">@T("Broker.SeeAllReviews")<i class="bi bi-arrow-up-right"></i><span></span></a>
            </div>
        </div>
    </div>
</section>

<section class="traning-plan overflow-hidden choose-section section" id="why-choose-us">
    <div class="container">
        <div class="row flex-row-reverse gy-5 gy-xl-0 justify-content-between align-items-lg-center">
            <div class="col-xxl-6 col-xl-7 col-lg-7 col-md-6">
                <div class="section__content">
                    <span class="section__content-sub-title headingFour mb-lg-4 mb-3"><img src="@Img("element/section-badge1.png")" alt="@T("Common.BadgeAlt")" /> @T("Choose.Badge")</span>
                    <h2 class="section__content-title">@T("Choose.Title")</h2>
                    <p class="section__content-text">@T("Choose.Description")</p>
                    <ul class="section__content-list ms-0 gap-xl-4 gap-lg-3 gap-2">
                        @foreach (var reason in ChooseUsPoints)
                        {
                            <li class="headingFive fw-normal fw-500 d-flex align-items-center gap-2"><i class="bi bi-check2-circle"></i> @reason</li>
                        }
                    </ul>
                    <a href="/#about-us" class="btn_theme btn_theme_active mt_40">@T("Choose.ReadMore") <i class="bi bi-arrow-up-right"></i><span></span></a>
                </div>
            </div>
            <div class="col-xxl-5 col-xl-5 col-lg-5 col-md-6">
                <div class="choose-thumb1">
                    <img src="@Img("about/choose-thumb1.png")" alt="@T("Choose.ImageAlt")" />
                </div>
            </div>
        </div>
    </div>
    <img src="@Img("element/choose-globe.png")" alt="@T("Choose.GlobeAlt")" class="choose-globe d-lg-block d-none" />
    <img src="@Img("element/choose-line.png")" alt="@T("Choose.LineAlt")" class="choole-line" />
</section>

<section class="working-process-section section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-6 col-xxl-5">
                <div class="section__header">
                    <span class="section__header-sub-title headingFour"><img src="@Img("element/section-badge1.png")" alt="@T("Common.BadgeAlt")" /> @T("Workflow.Badge")</span>
                    <h2 class="section__header-title">@T("Workflow.Title")</h2>
                    <p class="section__header-content ch-xxl">@T("Workflow.Description")</p>
                </div>
            </div>
        </div>
        <div class="row g-2 g-md-4">
            @foreach (var step in WorkingSteps)
            {
                <div class="col-12 col-sm-6 col-xxl-3">
                    <div class="card card--custom td-card-fill">
                        <div class="card__icon">
                            <img src="@Img(step.Icon)" alt="@GetIconAlt(step.Title)" />
                            <span class="number-bullet">@step.Number</span>
                        </div>
                        <div class="card__content">
                            <h4 class="card__title">@step.Title</h4>
                            <p class="fs-small">@step.Description</p>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
    <img src="@Img("review/working-trades-ele.png")" alt="@T("Workflow.ProcessElementAlt")" class="working-process-ele" />
</section>

<section class="about-section cmn-bg2 section" id="about-us">
    <img src="@Img("element/message-ele.png")" alt="@T("About.MessageElementAlt")" class="message-ele" />
    <div class="container">
        <div class="row gy-5 gy-lg-0 justify-content-between align-items-center">
            <div class="col-12 col-lg-7 col-xxl-6">
                <div class="section__content">
                    <span class="section__content-sub-title headingFour mb-lg-4 mb-3"><img src="@Img("element/section-badge1.png")" alt="@T("Common.BadgeAlt")" /> @T("About.Badge")</span>
                    <h2 class="section__content-title">@T("About.Title")</h2>
                    <p class="section__content-text">@T("About.Description")</p>
                    <div class="section__content-inner">
                        @foreach (var feature in AboutFeatures)
                        {
                            <div class="card card--small">
                                <div class="card--small-icon white-bg border">
                                    <img src="@Img(feature.Icon)" alt="@GetIconAlt(feature.Title)" />
                                </div>
                                <div class="card--small-content">
                                    <h5 class="card--small-title">@feature.Title</h5>
                                    <p class="card--small-text">@feature.Description</p>
                                </div>
                            </div>
                        }
                    </div>
                    <a href="/#about-us" class="btn_theme btn_theme_active mt_40">@T("About.ReadMore") <i class="bi bi-arrow-up-right"></i><span></span></a>
                </div>
            </div>
            <div class="col-12 col-md-8 col-lg-5 mx-auto mx-lg-0">
                <div class="choose-us__thumb unset-xxl me-xl-4 me-xxl-0">
                    <img src="@Img("about/about1.png")" alt="@T("About.ImageAlt")" />
                </div>
            </div>
        </div>
    </div>
</section>

<section class="traning-plan section" id="video-tutorial">
    <div class="container">
        <div class="row flex-row-reverse gy-5 gy-xl-0 justify-content-between align-items-lg-center">
            <div class="col-xxl-6 col-xl-7 col-lg-7 col-md-6">
                <div class="section__content">
                    <span class="section__content-sub-title headingFour mb-lg-4 mb-3"><img src="@Img("element/section-badge1.png")" alt="@T("Common.BadgeAlt")" /> @T("Video.Badge")</span>
                    <h2 class="section__content-title">@T("Video.Title")</h2>
                    <p class="section__content-text">@T("Video.Description")</p>
                    <ul class="section__content-list">
                        @foreach (var item in VideoTopics)
                        {
                            <li class="headingFive fw-500">@item</li>
                        }
                    </ul>
                    <a href="/#video-tutorial" class="btn_theme btn_theme_active mt_40">@T("Video.WatchVideos") <i class="bi bi-arrow-up-right"></i><span></span></a>
                </div>
            </div>
            <div class="col-xxl-5 col-xl-5 col-lg-5 col-md-6">
                <div class="traning-plan-thumb w-100">
                    <img src="@Img("app/apps-thumb2.png")" alt="@T("Video.PreviewAlt")" class="w-100" />
                </div>
            </div>
        </div>
    </div>
</section>

<section class="testimonials section">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-6 col-xxl-5">
                <div class="section__header">
                    <span class="section__header-sub-title headingFour"><img src="@Img("element/section-badge1.png")" alt="@T("Common.BadgeAlt")" />@T("Testimonials.Badge")</span>
                    <h2 class="section__header-title">@T("Testimonials.Title")</h2>
                    <p class="section__header-content">@T("Testimonials.Description")</p>
                </div>
            </div>
        </div>
        <div class="row g-4">
            @foreach (var testimonial in Testimonials)
            {
                <div class="col-12 col-lg-4">
                    <div class="card card--custom td-card-fill">
                        <div class="testimonials__author-review">
                            <div class="star_review mb-3">
                                @for (var i = 0; i < 4; i++)
                                {
                                    <i class="bi bi-star-fill secondary-clr2"></i>
                                }
                                <i class="bi bi-star-half secondary-clr2"></i>
                            </div>
                            <p class="text-start">"@testimonial.Quote"</p>
                        </div>
                        <div class="testimonials__author">
                            <div class="author__thumg">
                                <img src="@Img(testimonial.Image)" alt="@testimonial.Name" class="rounded-circle" />
                            </div>
                            <div class="author__content">
                                <h5 class="author__title">@testimonial.Name</h5>
                                <p class="author__desi">@testimonial.Role</p>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section class="download-app cmn-bg2 section overflow-hidden">
    <div class="container">
        <div class="row justify-content-center justify-content-md-between align-items-center gy-5 gy-lg-0">
            <div class="col-md-5 col-lg-5 col-xl-5 col-xxl-5 order-1 order-lg-0">
                <div class="download-app__thumb01">
                    <div class="thumb">
                        <img src="@Img("app/download-app1.png")" alt="@T("Download.ScreenshotAlt")" />
                    </div>
                    <img src="@Img("app/app-circle1.png")" alt="@T("Download.CircleAlt")" class="app-circle" />
                </div>
            </div>
            <div class="col-md-7 col-lg-6 col-xl-6 col-xxl-6">
                <div class="section__content ms-lg-4 ms-xl-0">
                    <span class="section__content-sub-title headingFour mb-lg-4 mb-3"><img src="@Img("element/section-badge1.png")" alt="@T("Common.BadgeAlt")" /> @T("Download.Badge")</span>
                    <h2 class="section__content-title">@T("Download.Title")</h2>
                    <p class="section__content-text mb-4 pb-lg-1">@T("Download.Description")</p>
                    <ul class="section__content-list02 d-grid gap-3">
                        @foreach (var bullet in DownloadBullets)
                        {
                            <li class="headingFive fw-normal d-flex align-items-center gap-2"><i class="bi bi-check2-circle"></i> @bullet</li>
                        }
                    </ul>
                    <div class="btn-group mt_40">
                        <a href="@RoutePaths.Ui.CotHome" class="btn_theme">@T("Download.OpenCot")<span></span></a>
                        <a href="@RoutePaths.Ui.CurrencyStrength" class="btn_theme">@T("Download.OpenStrength")<span></span></a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section class="section faq-section" id="faqa">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-7 col-xxl-6">
                <div class="section__header">
                    <span class="section__header-sub-title headingFour"><img src="@Img("element/section-badge1.png")" alt="@T("Common.BadgeAlt")" />@T("Faq.Badge")</span>
                    <h2 class="section__header-title">@T("Faq.Title")</h2>
                    <p class="section__header-content">@T("Faq.Description")</p>
                </div>
            </div>
        </div>
        <div class="row justify-content-between gy-4 gy-lg-0">
            <div class="col-12 col-lg-6 col-xxl-6">
                <div class="accordion" id="faq-left">
                    @foreach (var faq in LeftFaqs)
                    {
                        <div class="accordion-item @(faq.Expanded ? "accordion_bg" : string.Empty)">
                            <h5 class="accordion-header">
                                <button class="accordion-button @(faq.Expanded ? string.Empty : "collapsed")" type="button" data-bs-toggle="collapse" data-bs-target="#@faq.CollapseId" aria-expanded="@faq.Expanded.ToString().ToLowerInvariant()" aria-controls="@faq.CollapseId">
                                    @faq.Question
                                </button>
                            </h5>
                            <div id="@faq.CollapseId" class="accordion-collapse collapse @(faq.Expanded ? "show" : null)" data-bs-parent="#faq-left">
                                <div class="accordion-body">
                                    <p class="mb-0">@faq.Answer</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
            <div class="col-12 col-lg-6 col-xxl-6">
                <div class="accordion" id="faq-right">
                    @foreach (var faq in RightFaqs)
                    {
                        <div class="accordion-item">
                            <h5 class="accordion-header">
                                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#@faq.CollapseId" aria-expanded="false" aria-controls="@faq.CollapseId">
                                    @faq.Question
                                </button>
                            </h5>
                            <div id="@faq.CollapseId" class="accordion-collapse collapse" data-bs-parent="#faq-right">
                                <div class="accordion-body">
                                    <p class="mb-0">@faq.Answer</p>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</section>
