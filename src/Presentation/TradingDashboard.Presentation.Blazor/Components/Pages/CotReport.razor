@page "/cot/{InstrumentSlug}"

<PageTitle>COT Report</PageTitle>

<MudStack Spacing="3">
    <CotBreadcrumb CurrentPageTitle="@GetBreadcrumbTitle()" />

    <MudPaper Class="pa-6">
        <MudStack AlignItems="AlignItems.Center" Spacing="2">
            <MudText Typo="Typo.h3" Align="Align.Center">
                COT Report: @GetDisplayName(InstrumentSlug)
            </MudText>

            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center">
                <MudText Typo="Typo.h4">Futures Only Positions as of 2026-02-03</MudText>
                <MudButton Variant="Variant.Filled" Color="Color.Success">View Historical Data</MudButton>
            </MudStack>

            <MudText Typo="Typo.body1" Align="Align.Left" Class="mt-4">
                Below is the Commitments of Traders (COT) report for @GetDisplayName(InstrumentSlug)
                (@GetModelDescription()) with COT charts.
            </MudText>
        </MudStack>
    </MudPaper>

    <CotReportTable Model="@ReportModel" />
</MudStack>
