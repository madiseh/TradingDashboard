<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MudBlazor" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\Application\TradingDashboard.Application\TradingDashboard.Application.Abstraction.csproj" />
    <ProjectReference Include="..\Common\TradingDashboard.Presentation.Common\TradingDashboard.Presentation.Common.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <CotApiProjectPath>$(MSBuildProjectDirectory)\..\..\Features\Cot\TradingDashboard.Features.Cot.Presentation.Api\TradingDashboard.Features.Cot.Presentation.Api.csproj</CotApiProjectPath>
    <CotApiAssemblyPath>$(MSBuildProjectDirectory)\..\..\Features\Cot\TradingDashboard.Features.Cot.Presentation.Api\bin\$(Configuration)\net9.0\TradingDashboard.Features.Cot.Presentation.Api.dll</CotApiAssemblyPath>
    <CotOpenApiPath>$(MSBuildProjectDirectory)\OpenApi\cot.v1.json</CotOpenApiPath>

    <LoginApiProjectPath>$(MSBuildProjectDirectory)\..\..\Features\Login\TradingDashboard.Features.Login.Presentation.Api\TradingDashboard.Features.Login.Presentation.Api.csproj</LoginApiProjectPath>
    <LoginApiAssemblyPath>$(MSBuildProjectDirectory)\..\..\Features\Login\TradingDashboard.Features.Login.Presentation.Api\bin\$(Configuration)\net9.0\TradingDashboard.Features.Login.Presentation.Api.dll</LoginApiAssemblyPath>
    <LoginOpenApiPath>$(MSBuildProjectDirectory)\OpenApi\login.v1.json</LoginOpenApiPath>
  </PropertyGroup>

  <Target Name="GenerateOpenApiContracts"
          BeforeTargets="BeforeCompile"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <MakeDir Directories="$(MSBuildProjectDirectory)\OpenApi" />
    <MakeDir Directories="$(MSBuildProjectDirectory)\Contracts\Generated\Cot" />
    <MakeDir Directories="$(MSBuildProjectDirectory)\Contracts\Generated\Login" />

    <Exec Command="dotnet build &quot;$(CotApiProjectPath)&quot; -c $(Configuration) --nologo --verbosity:minimal" />
    <Exec Command="dotnet build &quot;$(LoginApiProjectPath)&quot; -c $(Configuration) --nologo --verbosity:minimal" />
    <Exec Command="dotnet tool restore --tool-manifest &quot;$(MSBuildProjectDirectory)\..\..\..\.config\dotnet-tools.json&quot;" />

    <Exec Command="dotnet tool run swagger tofile --output &quot;$(CotOpenApiPath)&quot; &quot;$(CotApiAssemblyPath)&quot; v1"
          EnvironmentVariables="TD_SKIP_DB_INIT=true" />
    <Exec Command="dotnet tool run swagger tofile --output &quot;$(LoginOpenApiPath)&quot; &quot;$(LoginApiAssemblyPath)&quot; v1"
          EnvironmentVariables="TD_SKIP_DB_INIT=true" />

    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Tools\GenerateContractsFromOpenApi.ps1&quot; -OpenApiPath &quot;$(CotOpenApiPath)&quot; -OutputDirectory &quot;$(MSBuildProjectDirectory)\Contracts\Generated\Cot&quot; -Namespace &quot;TradingDashboard.Presentation.Blazor.Contracts.Generated.Cot&quot; -PreserveFiles CotReportModel.cs" />
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\Tools\GenerateContractsFromOpenApi.ps1&quot; -OpenApiPath &quot;$(LoginOpenApiPath)&quot; -OutputDirectory &quot;$(MSBuildProjectDirectory)\Contracts\Generated\Login&quot; -Namespace &quot;TradingDashboard.Presentation.Blazor.Contracts.Generated.Login&quot;" />
  </Target>

</Project>
